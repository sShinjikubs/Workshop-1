<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0f1a"/>
      <stop offset="100%" stop-color="#050810"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ff6b00" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#0a0f1a" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="body" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#2a2a2a"/>
      <stop offset="50%" stop-color="#1a1a1a"/>
      <stop offset="100%" stop-color="#111111"/>
    </linearGradient>
    <linearGradient id="grill" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#333333"/>
      <stop offset="100%" stop-color="#222222"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="20" stdDeviation="25" flood-color="#000" flood-opacity="0.7"/>
    </filter>
  </defs>

  <rect width="600" height="500" fill="url(#bg)"/>
  <ellipse cx="300" cy="250" rx="250" ry="180" fill="url(#glow)"/>

  <!-- Speaker body - cylindrical horizontal -->
  <g filter="url(#shadow)" transform="translate(60, 150)">
    <!-- Left passive radiator cap -->
    <ellipse cx="52" cy="100" rx="45" ry="45" fill="#1a1a1a" stroke="#ff6b00" stroke-width="5"/>
    <ellipse cx="52" cy="100" rx="30" ry="30" fill="#111111"/>
    <ellipse cx="52" cy="100" rx="14" ry="14" fill="#ff6b00" opacity="0.5"/>

    <!-- Main cylinder body -->
    <rect x="45" y="55" width="390" height="90" rx="20" fill="url(#body)" stroke="#333" stroke-width="2"/>

    <!-- JBL Fabric Grill texture -->
    <rect x="60" y="63" width="360" height="74" rx="15" fill="url(#grill)" opacity="0.8"/>

    <!-- Dots pattern for grill -->
    <pattern id="dots" width="8" height="8" patternUnits="userSpaceOnUse">
      <circle cx="4" cy="4" r="1.5" fill="#444" opacity="0.6"/>
    </pattern>
    <rect x="60" y="63" width="360" height="74" rx="15" fill="url(#dots)"/>

    <!-- JBL Logo Badge (Orange Pill) -->
    <rect x="175" y="78" width="130" height="44" rx="10" fill="#ff6b00"/>
    <text x="240" y="107" font-family="'Arial Black', Arial" font-size="32" font-weight="900" fill="white" text-anchor="middle" letter-spacing="2">JBL</text>

    <!-- Right passive radiator cap -->
    <ellipse cx="435" cy="100" rx="45" ry="45" fill="#1a1a1a" stroke="#ff6b00" stroke-width="5"/>
    <ellipse cx="435" cy="100" rx="30" ry="30" fill="#111111"/>
    <ellipse cx="435" cy="100" rx="14" ry="14" fill="#ff6b00" opacity="0.5"/>

    <!-- IP67 Badge -->
    <rect x="50" y="155" width="60" height="22" rx="5" fill="#ff6b00" opacity="0.9"/>
    <text x="80" y="170" font-family="Arial" font-size="11" font-weight="700" fill="white" text-anchor="middle">IP67</text>

    <!-- Charging port area -->
    <rect x="200" y="152" width="50" height="10" rx="3" fill="#333"/>
  </g>

  <!-- Label -->
  <rect x="0" y="420" width="600" height="80" fill="#050810" opacity="0.95"/>
  <text x="30" y="450" font-family="Arial" font-size="13" font-weight="700" fill="#ff6b00" letter-spacing="3">JBL</text>
  <text x="30" y="470" font-family="Arial" font-size="16" font-weight="800" fill="#ffffff">Flip 6 Portable Bluetooth Speaker</text>
  <text x="570" y="470" font-family="Arial" font-size="18" font-weight="900" fill="#ff6b00" text-anchor="end">฿5,190</text>
  <text x="30" y="490" font-family="Arial" font-size="11" fill="#9ca3af">IP67 Waterproof • 12H Battery • PartyBoost</text>
</svg>
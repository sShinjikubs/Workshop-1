graph TB
    subgraph Client_Layer ["📱 Client Layer (Frontend — React + Vite SPA)"]
        A1["💻 User / Seller Portal\n(Customer UI + Seller Portal)"]
        A2["👔 Manager Dashboard\n(/manager)"]
        A3["👑 Admin Dashboard\n(/admin)"]
    end

    subgraph Backend_Layer ["⚙️ Backend API Server (Express + TypeScript)"]
        AuthSvc["👤 Auth & Profile\n/api/auth/*"]
        ProductSvc["📦 Product Catalog\n/api/products/*"]
        OrderSvc["🧾 Order & Payment\n/api/orders/*"]
        SellerSvc["🛍️ Seller & Inspection\n/api/pending-watches/*"]
        ReviewSvc["⭐ Reviews & Wishlist\n/api/reviews/*, /api/wishlist/*"]
        PaymentSvc["💳 PromptPay QR\n/api/payment/qr"]
        LogSvc["📋 System Logs & Users\n/api/logs, /api/users"]
    end

    subgraph Data_Layer ["💾 Database & Storage Layer"]
        SQL_DB[("🗄️ Primary SQL DB\n(PostgreSQL)\nUsers, Products, Orders\nReviews, Wishlist, Logs")]
        JSON_DB[("📁 JSON Fallback DB\n(db.json)\nAuto-fallback ถ้า Postgres ไม่พร้อม")]
    end

    %% Client to Backend
    A1 --> AuthSvc & ProductSvc & OrderSvc & ReviewSvc & PaymentSvc & SellerSvc
    A2 --> OrderSvc & ProductSvc & SellerSvc & LogSvc
    A3 --> AuthSvc & OrderSvc & ProductSvc & SellerSvc & LogSvc

    %% Backend to Database
    AuthSvc & ProductSvc & OrderSvc & SellerSvc & ReviewSvc & LogSvc --> SQL_DB
    SQL_DB -.->|"Auto-fallback"| JSON_DB

    %% Style
    classDef client fill:#0f172a,stroke:#c5a880,stroke-width:2px,color:#fff;
    classDef backend fill:#064e3b,stroke:#34d399,stroke-width:2px,color:#fff;
    classDef data fill:#78350f,stroke:#fbbf24,stroke-width:2px,color:#fff;

    class A1,A2,A3 client;
    class AuthSvc,ProductSvc,OrderSvc,SellerSvc,ReviewSvc,PaymentSvc,LogSvc backend;
    class SQL_DB,JSON_DB data;
